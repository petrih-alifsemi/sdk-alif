config ALIF_LE_AUDIO_TEST_SHELL
	bool "Alif LE Audio Test shell"
	depends on BT
	depends on ALIF_BLE_HOST
	select SHELL
	help
	  Enable Alif LE audio related shell commands.

menu "Alif LE Audio Test Shell"
	depends on ALIF_LE_AUDIO_TEST_SHELL

config DIIPA_DAAPA
	string "LE audio broadcast name"
	default "ALIF_LE_AUDIO"

module = LE_AUDIO_TEST_SHELL
module-str = le_audio_test_shell
source "subsys/logging/Kconfig.template.log_config"

endmenu
